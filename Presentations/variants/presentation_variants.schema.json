{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gecompat/SQL_PerformanceSchulung/Presentations/variants/presentation_variants.schema.json",
  "title": "SQL Performance Schulung presentation variants",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "master_deck",
    "master_sha256",
    "profiles",
    "slides",
    "build"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "master_deck": {
      "type": "string",
      "pattern": "^Presentations/(?!.*\\.\\.)[^\\\\]+\\.pptx$"
    },
    "master_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["BASIS", "STANDARD", "VERTIEFUNG"],
      "properties": {
        "BASIS": {
          "$ref": "#/$defs/profile"
        },
        "STANDARD": {
          "$ref": "#/$defs/profile"
        },
        "VERTIEFUNG": {
          "$ref": "#/$defs/profile"
        }
      }
    },
    "slides": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^SLD-M0[0-7]-[0-9]{3}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/slide"
      }
    },
    "build": {
      "$ref": "#/$defs/build"
    }
  },
  "$defs": {
    "slideKey": {
      "type": "string",
      "pattern": "^SLD-M0[0-7]-[0-9]{3}$"
    },
    "depth": {
      "type": "string",
      "enum": ["BASIS", "STANDARD", "VERTIEFUNG"]
    },
    "role": {
      "type": "string",
      "enum": [
        "INTRO",
        "THEORY",
        "DEMO_INTRO",
        "DEMO_EXECUTION",
        "DEMO_RESULT",
        "LAB",
        "EXERCISE",
        "SOLUTION",
        "SUMMARY",
        "TRANSITION",
        "REFERENCE"
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["custom_show", "include_depth", "include_roles"],
      "properties": {
        "custom_show": {
          "type": "string",
          "minLength": 1
        },
        "include_depth": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/depth"
          }
        },
        "include_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "exclude_slide_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slideKey"
          },
          "default": []
        },
        "rationale": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "profileOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "include", "reason"],
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["BASIS", "STANDARD", "VERTIEFUNG"]
        },
        "include": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "module",
        "depth",
        "roles",
        "title",
        "claims",
        "sources",
        "learning_objectives",
        "demos",
        "requires",
        "paired_with",
        "links_to",
        "profile_overrides",
        "notes_required"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "module": {
          "type": "string",
          "pattern": "^M0[0-7]$"
        },
        "depth": {
          "$ref": "#/$defs/depth"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "claims": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(CLM-[0-9]{3}|ADV-CLM-[0-9]{3})$"
          }
        },
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SRC-[0-9]{3}$"
          }
        },
        "learning_objectives": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^LO-M0[0-7]-[0-9]{2}$"
          }
        },
        "demos": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(FWK|STL|OPT|QRY|IDX|CON|RES|DGN|INF)-[0-9]{3}$"
          }
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slideKey"
          }
        },
        "paired_with": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slideKey"
          }
        },
        "links_to": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slideKey"
          }
        },
        "profile_overrides": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/profileOverride"
          }
        },
        "notes_required": {
          "type": "boolean"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_directory",
        "filename_pattern",
        "preserve_master",
        "delete_excluded_descending",
        "fail_on_broken_links"
      ],
      "properties": {
        "output_directory": {
          "type": "string",
          "pattern": "^Presentations/variants/build$"
        },
        "filename_pattern": {
          "const": "SQL_PerformanceSchulung_{PROFILE}_{MASTER_SHORT_HASH}.pptx"
        },
        "preserve_master": {
          "const": true
        },
        "delete_excluded_descending": {
          "const": true
        },
        "fail_on_broken_links": {
          "const": true
        }
      }
    }
  }
}
