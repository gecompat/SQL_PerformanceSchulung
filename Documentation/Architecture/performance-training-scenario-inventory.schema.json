{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gecompat/SQL_PerformanceSchulung/raw/main/Documentation/Architecture/performance-training-scenario-inventory.schema.json",
  "title": "Performance Training Scenario Inventory",
  "type": "object",
  "required": ["contractVersion", "status", "repository", "provisioningFramework", "classificationModel", "orchestrationModel", "scenarios", "nextActions"],
  "properties": {
    "$schema": {"type": "string"},
    "contractVersion": {"const": "1.1"},
    "status": {"enum": ["IN_PROGRESS", "ASSESSED_PARTIAL", "ASSESSED_COMPLETE"]},
    "scope": {"type": "string"},
    "repository": {"const": "gecompat/SQL_PerformanceSchulung"},
    "provisioningFramework": {"const": "gecompat/SQL_Server_Lab"},
    "evidenceSources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "classificationModel": {
      "type": "object", "required": ["A", "B", "C", "D"],
      "properties": {"A": {"type": "string"}, "B": {"type": "string"}, "C": {"type": "string"}, "D": {"type": "string"}},
      "additionalProperties": false
    },
    "orchestrationModel": {
      "type": "object", "required": ["MANUAL", "RUNNER_ASSISTED", "AUTOMATED_VERIFY"],
      "properties": {
        "MANUAL": {"type": "string"},
        "RUNNER_ASSISTED": {"type": "string"},
        "AUTOMATED_VERIFY": {"type": "string"}
      },
      "additionalProperties": false
    },
    "scenarios": {"type": "array", "items": {"$ref": "#/definitions/inventoryEntry"}},
    "wave2Decisions": {"type": "object"},
    "nextActions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false,
  "definitions": {
    "inventoryEntry": {
      "type": "object",
      "required": [
        "demoId", "title", "inventoryStatus", "implementationStatus", "classification", "safetyLevel",
        "supportedProviders", "sqlVersions", "sessionModel", "primaryOrchestrationMode", "supportedOrchestrationModes",
        "forcedCondition", "verification", "resetStrategy", "verticalSliceCandidate"
      ],
      "properties": {
        "demoId": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{3}(?:_[A-Z0-9_]+)?$"},
        "path": {"type": ["string", "null"]},
        "title": {"type": "string", "minLength": 1},
        "inventoryStatus": {"enum": ["PLANNED", "PRELIMINARY", "ASSESSED"]},
        "implementationStatus": {"enum": ["PLANNED", "IMPLEMENTED", "VALIDATED", "RETIRED"]},
        "classification": {"enum": ["A", "B", "C", "D"]},
        "safetyLevel": {"enum": ["GREEN", "YELLOW", "RED"]},
        "supportedProviders": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["docker", "podman", "hyperv", "mixed"]}},
        "sqlVersions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["2019", "2022", "2025"]}},
        "sessionModel": {"enum": ["SINGLE_SESSION", "MULTI_SESSION", "SINGLE_OR_MULTI_SESSION"]},
        "sessionCount": {"type": "integer", "minimum": 1, "maximum": 32},
        "primaryOrchestrationMode": {"enum": ["MANUAL", "RUNNER_ASSISTED", "AUTOMATED_VERIFY"]},
        "supportedOrchestrationModes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["MANUAL", "RUNNER_ASSISTED", "AUTOMATED_VERIFY"]}
        },
        "environmentIsolation": {"enum": ["SHARED_PROVIDER_VERSION", "FRESH_DATABASE", "FRESH_INSTANCE", "DEDICATED_HOST"]},
        "requiredCapabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
        "forcedCondition": {"type": "string", "minLength": 1},
        "synchronization": {"type": "string"},
        "verification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "resetStrategy": {"enum": ["DATABASE_RECREATE", "BASELINE_RESTORE", "IDEMPOTENT_RESET", "FULL_REPROVISION"]},
        "hostMinimum": {
          "type": "object", "required": ["cpu", "memoryMB", "storageGB"],
          "properties": {"cpu": {"type": "integer", "minimum": 1}, "memoryMB": {"type": "integer", "minimum": 2048}, "storageGB": {"type": "integer", "minimum": 1}},
          "additionalProperties": false
        },
        "verticalSliceCandidate": {"type": "boolean"},
        "knownLimits": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  }
}